{
  "name": "Quizora design tokens",
  "version": "1.0.0",
  "source": {
    "stylesheet": "https://cdn.flexiquiz.com/ps/css/fq-base.min.css?v=14a728n.454",
    "page": "https://www.flexiquiz.com/",
    "note": "Every value below was read from the FlexiQuiz stylesheet (Quizora base) or page markup. Values marked 'observed' appear in the stylesheet but have no documented role. Do not add values that are not in the source."
  },
  "color": {
    "brand": {
      "blue": { "$value": "#0071f2", "usage": "Primary button, focus ring, eyebrow text, Streamlit primaryColor" },
      "navy": { "$value": "#0f1048", "usage": "Headings, nav and link text, dark section background, Streamlit linkColor" },
      "seaGreen": { "$value": "#32a775", "usage": "Optional secondary button" },
      "mint": { "$value": "#e3f7ee", "usage": "Soft fill, status chips such as 'open'" },
      "lightVibrantBlue": { "$value": "#7272ff", "usage": "Observed: light vibrant blue section and text" },
      "pastelBlue": { "$value": "#4576d4", "usage": "Observed: pastel blue text" },
      "emeraldGreen": { "$value": "#409384", "usage": "Observed: emerald green text" }
    },
    "accent": {
      "teal": { "$value": "#2cc6ab", "usage": "Reserved for future illustrations and stats. Not for text, borders or buttons in v1." },
      "yellow": { "$value": "#f5c900", "usage": "Reserved for future illustrations and stats." },
      "orange": { "$value": "#ff8f24", "usage": "Reserved for future illustrations and stats." },
      "cyan": { "$value": "#31b3eb", "usage": "Reserved for future illustrations and stats. Also the blue section background on the site." },
      "melon": { "$value": "#f8b4b6", "usage": "Reserved for future illustrations and stats." },
      "mulberry": { "$value": "#bc5185", "usage": "Observed: mulberry section and text" },
      "error": { "$value": "#eb4963", "usage": "Error text only" }
    },
    "neutral": {
      "white": { "$value": "#ffffff", "usage": "Page background, Streamlit backgroundColor" },
      "black": { "$value": "#000000", "usage": "Observed: text on mint buttons" },
      "text": { "$value": "#212529", "usage": "Body text, Streamlit textColor" },
      "surface": { "$value": "#f7f8fa", "usage": "Input fields, plan panel, Streamlit secondaryBackgroundColor" },
      "border": { "$value": "#e0e0e0", "usage": "Dividers and input borders, Streamlit borderColor" },
      "borderSoft": { "$value": "#ddd", "usage": "Observed: lighter divider" },
      "muted": { "$value": "#9ca5b0", "usage": "Captions and secondary labels. See accessibility: fails 4.5:1 for small text on white." },
      "sectionGray": { "$value": "#e0e3e7", "usage": "Observed: dark gray section background" }
    },
    "section": {
      "floralWhite": { "$value": "#fef9f4", "usage": "Observed: section background" },
      "lace": { "$value": "#fff4e9", "usage": "Observed: section background" },
      "palePink": { "$value": "#f8ddde", "usage": "Observed: section background" },
      "melon": { "$value": "#f8b4b6", "usage": "Observed: section background" },
      "yellow": { "$value": "#f5c900", "usage": "Observed: section background" },
      "orange": { "$value": "#ff8f24", "usage": "Observed: section background" }
    },
    "tint": {
      "lightBlue": { "$value": "#b5dbeb", "usage": "Observed: light blue text" },
      "paleBlue": { "$value": "#ebf7fd", "usage": "Observed: pale blue background" },
      "paleBlue2": { "$value": "#e4f0ff", "usage": "Observed: pale blue background" },
      "paleLavender": { "$value": "#f0f0ff", "usage": "Observed: pale lavender background" },
      "lavender": { "$value": "#d4d4ff", "usage": "Observed: lavender background" },
      "sky": { "$value": "#aed4ff", "usage": "Observed: sky blue background" },
      "seaFoam": { "$value": "#bbead6", "usage": "Observed: sea foam background" },
      "paleSeaGreen": { "$value": "#e8f8f1", "usage": "Observed: pale green background" },
      "paleRose": { "$value": "#fef7f7", "usage": "Observed: pale rose background" },
      "pinkBorder": { "$value": "#fad2d3", "usage": "Observed: pink border" }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": { "$value": "Poppins, sans-serif", "usage": "One family only. Loaded from Google Fonts (approved exception in the app)." }
    },
    "fontWeight": {
      "light": { "$value": 300 },
      "regular": { "$value": 400, "usage": "Default. Headings default to this." },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600, "usage": "Emphasis inside headings and paragraphs, text links, eyebrow labels" },
      "bold": { "$value": 700, "usage": "Card description" }
    },
    "fontSize": {
      "12": "12px",
      "14": "14px",
      "15": "15px",
      "16": "16px",
      "17": "17px",
      "18": "18px",
      "20": "20px",
      "22": "22px",
      "24": "24px",
      "26": "26px",
      "30": "30px",
      "32": "32px",
      "36": "36px",
      "38": "38px",
      "42": "42px",
      "44": "44px",
      "46": "46px",
      "52": "52px",
      "64": "64px"
    },
    "lineHeight": {
      "paragraph": { "$value": "25px", "usage": "Body paragraphs and h6" },
      "lead": { "$value": "31px", "usage": "Lead paragraphs" },
      "observed": ["20px", "22px", "29px", "40px", "50px", "1.5"]
    },
    "roles": {
      "h1": { "size": "64px", "weight": 400, "color": "brand.navy", "marginBottom": "1.5rem" },
      "h2": { "size": "44px", "weight": 400, "color": "brand.navy" },
      "h3": { "size": "36px", "weight": 400, "color": "brand.navy" },
      "strongInHeadingOrParagraph": { "weight": 600 },
      "eyebrow": { "weight": 600, "transform": "uppercase", "color": "brand.blue", "marginBottom": "20px" },
      "cardTitle": { "size": "16px", "transform": "uppercase" },
      "cardDescription": { "size": "24px", "weight": 700 },
      "cardDescriptionMedium": { "size": "22px" },
      "linkButton": { "weight": 600, "color": "brand.navy" },
      "referenceText": { "size": "18px", "weight": 500, "align": "right" }
    },
    "baseSizes": {
      "app": "16px (Streamlit baseFontSize, per ui-context.md)",
      "siteRootHtml": "15px (observed: html { font-size: 15px } on the site)"
    }
  },
  "space": {
    "10": "10px",
    "15": "15px",
    "20": "20px",
    "25": "25px",
    "40": "40px",
    "50": "50px",
    "60": "60px",
    "85": "85px",
    "100": "100px"
  },
  "section": {
    "paddingVertical": "100px",
    "paddingVerticalCombined": "40px",
    "descriptionMarginTop": "85px",
    "note": "100px is the marketing-site rhythm. The Streamlit app uses Streamlit's own spacing and must not add custom margins (ui-context.md)."
  },
  "radius": {
    "xs": "4px",
    "card": "12px",
    "smallButton": "20px",
    "pill": "25px"
  },
  "shadow": {
    "cardGlow": { "$value": "0 0 12px 12px rgba(52,178,234,.12)", "usage": "Only for a card that is the main result" },
    "lift": { "$value": "0 9px 9px rgba(52,178,234,.1)", "usage": "Observed once in the stylesheet, role not documented" },
    "none": { "$value": "none" }
  },
  "breakpoints": {
    "sm": "576px",
    "md": "768px",
    "lg": "992px",
    "xl": "1200px",
    "xxl": "1400px",
    "note": "Bootstrap 5 breakpoints. The site's media queries use these exact values."
  },
  "components": {
    "buttonPrimary": {
      "background": "brand.blue",
      "text": "neutral.white",
      "height": "50px",
      "width": "235px",
      "radius": "pill (25px)",
      "fontWeight": 400
    },
    "buttonSmall": {
      "height": "40px",
      "width": "100px",
      "radius": "20px"
    },
    "buttonSecondary": {
      "background": "brand.seaGreen",
      "text": "neutral.white"
    },
    "buttonSoft": {
      "background": "brand.mint",
      "text": "neutral.black"
    },
    "linkButton": {
      "text": "brand.navy",
      "fontWeight": 600,
      "decoration": "none"
    },
    "card": {
      "background": "neutral.white",
      "radius": "12px",
      "padding": "20px 40px 10px",
      "shadow": "none by default; shadow.cardGlow only for the main result"
    },
    "inputField": {
      "background": "neutral.surface",
      "border": "neutral.border",
      "label": "always visible (never placeholder only)"
    },
    "statusChip": {
      "background": "brand.mint",
      "text": "neutral.text"
    }
  },
  "accessibility": {
    "method": "WCAG 2.x relative luminance contrast. AA normal text needs 4.5:1. AA large text (18pt or 14pt bold) needs 3:1.",
    "pairs": [
      { "fg": "#0f1048", "bg": "#ffffff", "ratio": 17.68, "aaNormal": "pass" },
      { "fg": "#212529", "bg": "#ffffff", "ratio": 15.43, "aaNormal": "pass" },
      { "fg": "#ffffff", "bg": "#0071f2", "ratio": 4.52, "aaNormal": "pass (marginal)" },
      { "fg": "#0071f2", "bg": "#ffffff", "ratio": 4.52, "aaNormal": "pass (marginal)" },
      { "fg": "#0071f2", "bg": "#f7f8fa", "ratio": 4.26, "aaNormal": "fail for small text", "aaLarge": "pass" },
      { "fg": "#9ca5b0", "bg": "#ffffff", "ratio": 2.49, "aaNormal": "fail", "aaLarge": "fail" },
      { "fg": "#9ca5b0", "bg": "#f7f8fa", "ratio": 2.35, "aaNormal": "fail", "aaLarge": "fail" },
      { "fg": "#eb4963", "bg": "#ffffff", "ratio": 3.71, "aaNormal": "fail", "aaLarge": "pass" },
      { "fg": "#ffffff", "bg": "#32a775", "ratio": 3.03, "aaNormal": "fail", "aaLarge": "pass" },
      { "fg": "#212529", "bg": "#f7f8fa", "ratio": 14.52, "aaNormal": "pass" },
      { "fg": "#0f1048", "bg": "#e3f7ee", "ratio": 15.83, "aaNormal": "pass" },
      { "fg": "#ffffff", "bg": "#0f1048", "ratio": 17.68, "aaNormal": "pass" }
    ],
    "openIssues": [
      "Muted #9ca5b0 fails AA for captions on white and on surface. Do not use it for text that carries meaning until a darker muted token is chosen and approved. The site uses it for only two rules.",
      "Error #eb4963 fails AA for normal text on white (3.71:1). ui-context.md limits it to error text. Use it at 18px or larger, or bold 14px, or pair it with an icon and text.",
      "White on seaGreen #32a775 fails AA for normal text (3.03:1). Use it only for large text or change the secondary button text color after review."
    ]
  },
  "streamlit": {
    "file": ".streamlit/config.toml",
    "theme": {
      "primaryColor": "#0071f2",
      "backgroundColor": "#ffffff",
      "secondaryBackgroundColor": "#f7f8fa",
      "textColor": "#212529",
      "linkColor": "#0f1048",
      "borderColor": "#e0e0e0",
      "baseRadius": "12px",
      "buttonRadius": "25px",
      "baseFontSize": 16,
      "baseFontWeight": 400
    },
    "notSupportedByStreamlitConfig": [
      "navy heading color (only in the HTML reference)",
      "card glow shadow",
      "100px section spacing"
    ]
  }
}
